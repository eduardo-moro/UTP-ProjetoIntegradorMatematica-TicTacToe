{
    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.default.cStandard": "c11",
    "C_Cpp.default.intelliSenseEngine": "Tag Parser",
    "C_Cpp.default.includePath": [
        "${workspaceFolder}",
        "${workspaceFolder}/src",
        "${workspaceFolder}/qml",
        "/usr/include/qt6",
        "/usr/include/qt6/QtCore",
        "/usr/include/qt6/QtQml",
        "/usr/include/qt6/QtQuick",
        "/usr/include/qt6/QtGui",
        "/usr/include/qt6/QtMultimedia"
    ],
    "files.exclude": {
        "build/**/*.o": true,
        "build/**/*.moc": true,
        "build/moc_*.cpp": true
    },
    "search.exclude": {
        "build": true
    },
    "cmake.enabled": false
}
