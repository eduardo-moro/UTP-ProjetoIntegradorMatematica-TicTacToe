{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Release",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "cd build && qmake6 ../tic-tac-toe.pro && make -j$(nproc)"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "isBackground": false
        },
        {
            "label": "Build Debug",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "cd build && qmake6 ../tic-tac-toe.pro -config debug && make -j$(nproc)"
            ],
            "group": {
                "kind": "build"
            },
            "problemMatcher": ["$gcc"],
            "isBackground": false
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "cd build && make clean"
            ],
            "group": {
                "kind": "build"
            }
        }
    ]
}
